# =============================================================================
# Faceless Video Generator - Environment Configuration Template
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Primary Recommended Providers (Free tiers available)
# -----------------------------------------------------------------------------

# Groq: Used for fast LLM story generation, Whisper STT transcription, and TTS
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Pollinations: Free-tier multi-model TTS and Flux image generation
# Get your key at: https://pollinations.ai / https://gen.pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Google Gemini: Free-tier text-to-speech (TTS)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Optional Image Generation Providers (Fallbacks)
# -----------------------------------------------------------------------------

# Replicate: Flux Schnell / Dev image generation
# https://replicate.com
REPLICATE_API_TOKEN=your_replicate_api_token_here

# FAL.ai: Fast Flux image generation
# https://fal.ai
FAL_KEY=your_fal_api_key_here

# Felo AI: Image generation endpoint
# https://openapi.felo.ai
FELO_API_KEY=your_felo_api_key_here

# -----------------------------------------------------------------------------
# Optional OpenAI Compatibility
# -----------------------------------------------------------------------------

# OpenAI: Can be used as fallback for LLM, TTS, or Whisper STT
# https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
# Optional base URL override (e.g. for custom proxies or local vLLM/Ollama endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1
